{
	"name": "basstabs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:rules": "REQUIRE_FIRESTORE_EMULATOR=1 firebase emulators:exec --only firestore --project demo-basstabs \"node --test tests/firestore.rules.test.mjs && vitest --run src/lib/cloud/write.integration.spec.ts\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^6.0.0",
		"@fontsource/caveat": "^5.3.0",
		"@lucide/svelte": "^1.81.0",
		"@skeletonlabs/skeleton": "^5.0.6",
		"@skeletonlabs/skeleton-svelte": "^5.0.6",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.11",
		"@vitest/browser-playwright": "^5.1.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"firebase-tools": "^15.37.0",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.4.0",
		"vitest": "^5.1.2",
		"vitest-browser-svelte": "^3.1.0"
	},
	"overrides": {
		"@firebase/firestore": {
			"@grpc/grpc-js": "^1.14.5"
		},
		"superstatic": "^11.0.0"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.2",
		"@codemirror/search": "^6.7.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.44.1",
		"firebase": "^13.4.0"
	}
}
