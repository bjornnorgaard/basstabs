{
	"name": "basstabs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:rules": "REQUIRE_FIRESTORE_EMULATOR=1 firebase emulators:exec --only firestore --project demo-basstabs \"node --test tests/firestore.rules.test.mjs && vitest --run src/lib/cloud/write.integration.spec.ts\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^6.0.0",
		"@fontsource/caveat": "^5.3.0",
		"@lucide/svelte": "^1.58.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^5.0.4",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"firebase-tools": "^15.33.0",
		"globals": "^17.13.0",
		"playwright": "^1.64.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"vitest-browser-svelte": "^3.1.0"
	},
	"overrides": {
		"@firebase/firestore": {
			"@grpc/grpc-js": "^1.14.5"
		},
		"superstatic": "^11.0.0"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"firebase": "^13.0.0"
	}
}
