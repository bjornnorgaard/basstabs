rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function canonicalPath(uid, tabId) {
      return /databases/$(database)/documents/users/$(uid)/tabs/$(tabId);
    }

    function publishedPath(shareId) {
      return /databases/$(database)/documents/publishedTabs/$(shareId);
    }

    function validContent(data) {
      return data.title is string && data.title.size() <= 200
        && data.artist is string && data.artist.size() <= 200
        && data.tuningId in ['standard-4', 'standard-5', 'standard-6']
        && data.source is string && data.source.size() <= 200000
        && data.syntaxVersion == 2
        && data.createdAt is int && data.createdAt > 0
        && data.updatedAt is int && data.updatedAt >= data.createdAt
        && data.updatedAt <= request.time.toMillis() + 300000;
    }

    function validCanonical(data) {
      return data.keys().hasAll([
          'title', 'artist', 'tuningId', 'source', 'syntaxVersion',
          'createdAt', 'updatedAt', 'visibility', 'shareId'
        ])
        && data.keys().hasOnly([
          'title', 'artist', 'tuningId', 'source', 'syntaxVersion',
          'createdAt', 'updatedAt', 'visibility', 'shareId'
        ])
        && validContent(data)
        && (data.visibility == 'private' && data.shareId == null
          || data.visibility in ['public', 'unlisted']
            && data.shareId is string
            && data.shareId.matches('^[0-9a-f]{32}$'));
    }

    function projection(data, uid, tabId) {
      return {
        'title': data.title,
        'artist': data.artist,
        'tuningId': data.tuningId,
        'source': data.source,
        'syntaxVersion': data.syntaxVersion,
        'createdAt': data.createdAt,
        'updatedAt': data.updatedAt,
        'visibility': data.visibility,
        'ownerId': uid,
        'tabId': tabId
      };
    }

    function hasMirror(data, uid, tabId) {
      return data.visibility == 'private'
        || getAfter(publishedPath(data.shareId)).data == projection(data, uid, tabId);
    }

    function removedPreviousMirror(previous, next) {
      return previous.visibility == 'private'
        || previous.shareId == next.shareId
        || getAfter(publishedPath(previous.shareId)) == null;
    }

    function coordinatedTitleWrite(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/cloudState/tabNames;
      return getAfter(path).data.revision == (exists(path) ? get(path).data.revision : 0) + 1;
    }

    match /users/{uid}/cloudState/tabNames {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['revision'])
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 0 : resource.data.revision) + 1;
    }

    match /users/{uid}/tabs/{tabId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validCanonical(request.resource.data)
        && coordinatedTitleWrite(uid)
        && hasMirror(request.resource.data, uid, tabId);
      allow update: if isOwner(uid)
        && validCanonical(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && (request.resource.data.title == resource.data.title || coordinatedTitleWrite(uid))
        && hasMirror(request.resource.data, uid, tabId)
        && removedPreviousMirror(resource.data, request.resource.data);
      allow delete: if isOwner(uid)
        && (resource.data.visibility == 'private'
          || getAfter(publishedPath(resource.data.shareId)) == null);
    }

    function validPublished(data, shareId) {
      return data.keys().hasAll([
          'title', 'artist', 'tuningId', 'source', 'syntaxVersion',
          'createdAt', 'updatedAt', 'visibility', 'ownerId', 'tabId'
        ])
        && data.keys().hasOnly([
          'title', 'artist', 'tuningId', 'source', 'syntaxVersion',
          'createdAt', 'updatedAt', 'visibility', 'ownerId', 'tabId'
        ])
        && validContent(data)
        && data.visibility in ['public', 'unlisted']
        && shareId.matches('^[0-9a-f]{32}$')
        && data.ownerId is string && data.tabId is string
        && data.tabId.size() > 0 && data.tabId.size() <= 1500
        && isOwner(data.ownerId);
    }

    function matchesCanonical(data, shareId) {
      let canonical = getAfter(canonicalPath(data.ownerId, data.tabId)).data;
      return canonical.shareId == shareId
        && data == projection(canonical, data.ownerId, data.tabId);
    }

    function noLongerShared(data, shareId) {
      let canonical = getAfter(canonicalPath(data.ownerId, data.tabId));
      return canonical == null
        || canonical.data.visibility == 'private'
        || canonical.data.shareId != shareId;
    }

    match /publishedTabs/{shareId} {
      allow get: if true;
      allow list: if resource.data.visibility == 'public';
      allow create: if validPublished(request.resource.data, shareId)
        && matchesCanonical(request.resource.data, shareId);
      allow update: if validPublished(request.resource.data, shareId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.tabId == resource.data.tabId
        && matchesCanonical(request.resource.data, shareId);
      allow delete: if isOwner(resource.data.ownerId)
        && noLongerShared(resource.data, shareId);
    }
  }
}
